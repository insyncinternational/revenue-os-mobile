{
  "expo": {
    "name": "GrowthReach.ai",
    "slug": "revenue-os-mobile",
    "owner": "asad1024s-organization",
    "version": "1.0.0",
    "scheme": "revenueos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f6f5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.revenueos.app",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.revenueos.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 96,
          "backgroundColor": "#14181e",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#14181e"
          }
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#f7820f",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GrowthReach.ai needs your photos to attach them to email replies.",
          "cameraPermission": "GrowthReach.ai needs the camera to take a photo for an email reply.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GrowthReach.ai uses Face ID to unlock the app when you turn on the app lock."
        }
      ],
      [
        "./plugins/withWidgetOpenApp",
        {
          "widgets": [
            "TodayWidget"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Replies, calls and meetings waiting for you, and what to do next.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/TodayWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 150,
                "initialLayout": "./src/widgets/TodayWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.revenueos.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.revenueos.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "c7c4afba-deac-4120-8a7d-7b4c7c73155f"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c7c4afba-deac-4120-8a7d-7b4c7c73155f"
    }
  }
}
